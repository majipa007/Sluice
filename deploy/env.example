# Copy to .env at the repo root and adjust:  cp deploy/env.example .env
# .env is gitignored — never commit real credentials. These are local
# development values only; anything beyond a laptop must take them from a
# secret store.

# --- Postgres -------------------------------------------------------------
# NOTE: POSTGRES_PASSWORD only takes effect on FIRST container init, because
# the password is then stored in the postgres-data volume. Changing it later
# needs either `ALTER USER postgres PASSWORD '...'` or `make nuke`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=sluice
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Password for the least-privilege application role. Written into the database
# by `make db-app-password`. Services connect as sluice_app, never as postgres.
SLUICE_APP_PASSWORD=sluice_app_dev_password

# --- RabbitMQ -------------------------------------------------------------
# Same caveat: only applied on first boot, then stored in rabbitmq-data.
RABBITMQ_DEFAULT_USER=sluice
RABBITMQ_DEFAULT_PASS=sluice_password

# --- pgAdmin --------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@sluice.local
PGADMIN_DEFAULT_PASSWORD=admin_password

# --- Gateway (consumed from session 3 onward) -----------------------------
HTTP_ADDR=:8080
API_TOKENS=dev_token
MAX_PAYLOAD_BYTES=1048576

PREFETCH_COUNT=1
MAX_ATTEMPTS=3
LEASE_TTL=30s
LEASE_RENEW_INTERVAL=10s        # must be < LEASE_TTL/2
REAPER_INTERVAL=10s
JOB_DEADLINE_DEFAULT=5m
CONSUMER_TIMEOUT=15m            # must exceed JOB_DEADLINE_DEFAULT; the copy
                                # that actually applies is in
                                # deploy/rabbitmq.conf
SHED_QUEUE_DEPTH=1000
SHUTDOWN_GRACE=90s              # must be < worker stop_grace_period (120s)
PAYLOAD_RETENTION=168h          # 7 days

# Unset disables tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
